# Copy to .env and change every "change-me" value before the first start.
#   cp .env.example .env
# Generate secrets with e.g.:  openssl rand -hex 32

# --- Public URLs (what the browser uses) ---
# Behind a reverse proxy with TLS use e.g. https://luciflor.example.ro and https://auth.luciflor.example.ro
APP_PUBLIC_URL=http://localhost:8211
KEYCLOAK_PUBLIC_URL=http://localhost:8210

# Host ports
WEB_PORT=8211
KEYCLOAK_PORT=8210

# --- PostgreSQL ---
POSTGRES_DB=luciflor
POSTGRES_USER=luciflor
POSTGRES_PASSWORD=change-me-postgres

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# --- Keycloak ---
# Master-realm admin for the Keycloak console (NOT the website admin).
KEYCLOAK_ADMIN_USER=kcadmin
KEYCLOAK_ADMIN_PASSWORD=change-me-kc-console

# Secret shared between Keycloak client "luciflor-web" and the web app.
KEYCLOAK_CLIENT_SECRET=change-me-client-secret

# "external" = HTTPS required except from localhost/private IPs; "all" in production behind TLS;
# "none" only for testing over plain HTTP on a public IP.
KC_SSL_REQUIRED=external

# --- Web app ---
SESSION_SECRET=change-me-session-secret
# Set to true once the site is served over HTTPS.
SESSION_HTTPS_ONLY=false
